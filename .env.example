# Application Environment: development | research | paper
APP_ENV=development

# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=text

# Directory overrides (optional; defaults resolve to project-local paths)
# XAU_DATA_DIR=
# XAU_LOGS_DIR=
# XAU_ARTIFACTS_DIR=

# Data source API placeholders (DO NOT populate with real secrets in this template)
# XAU_DATA_API_KEY=
